{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "sravyadatafactory1"
		},
		"AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"AzureSqlDatabase1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase1'"
		},
		"ls_sqlservertoadlsgen2_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sqlservertoadlsgen2'"
		},
		"ls_sqlservertoadlsgen2json_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_sqlservertoadlsgen2json'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sravyastorageaccount12.dfs.core.windows.net/"
		},
		"AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sravya1.database.windows.net"
		},
		"AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sravyadb"
		},
		"AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sravya12"
		},
		"ls_sqlservertoadlsgen2_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "manjula123.database.windows.net"
		},
		"ls_sqlservertoadlsgen2_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "retaildatabase"
		},
		"ls_sqlservertoadlsgen2_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "manjula"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "sravyadatafactory1_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorage1_connectionString": {
						"value": "[parameters('AzureBlobStorage1_connectionString')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"AzureSqlDatabase1_password": {
						"value": "[parameters('AzureSqlDatabase1_password')]"
					},
					"ls_sqlservertoadlsgen2_password": {
						"value": "[parameters('ls_sqlservertoadlsgen2_password')]"
					},
					"ls_sqlservertoadlsgen2json_connectionString": {
						"value": "[parameters('ls_sqlservertoadlsgen2json_connectionString')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_userName')]"
					},
					"ls_sqlservertoadlsgen2_properties_typeProperties_server": {
						"value": "[parameters('ls_sqlservertoadlsgen2_properties_typeProperties_server')]"
					},
					"ls_sqlservertoadlsgen2_properties_typeProperties_database": {
						"value": "[parameters('ls_sqlservertoadlsgen2_properties_typeProperties_database')]"
					},
					"ls_sqlservertoadlsgen2_properties_typeProperties_userName": {
						"value": "[parameters('ls_sqlservertoadlsgen2_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}